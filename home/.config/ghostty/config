# Font
# font-family = Berkeley Mono
font-size = 16

# Theme
theme = Ayu Mirage

# Terminal
background-opacity = 0.98
cursor-style = block
shell-integration-features = no-cursor
term = xterm-256color

# macOS options
macos-option-as-alt = true
macos-titlebar-style = tabs

# Window
window-padding-x = 10
window-padding-y = 10
# window-decoration = none
confirm-close-surface = false
mouse-shift-capture = false

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# Tabs
keybind = cmd+shift+r=prompt_tab_title

# Split panes (match WezTerm)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+equal=equalize_splits

# Navigate panes (match WezTerm)
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom

# Close pane
keybind = cmd+w=close_surface

# Shift+Enter for multi-line input in TUIs
keybind = shift+enter=text:\n

# Shell
command = /opt/homebrew/bin/fish --login
