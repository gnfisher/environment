#!/usr/bin/env bash
set -euo pipefail

readonly theme="${1:-}"
readonly state_file="$HOME/.local/state/environment-theme/current"

case "$theme" in
    everforest|dracula|modus-operandi|naysayer) ;;
    *)
        echo "Usage: theme-switch {everforest|dracula|modus-operandi|naysayer}" >&2
        exit 2
        ;;
esac

mkdir -p "$(dirname "$state_file")"
printf '%s\n' "$theme" > "$state_file"

echo "Applied Neovim theme: $theme"
