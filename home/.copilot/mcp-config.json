{
  "mcpServers": {
    "datadog": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,ddsql"
    },
    "splunk": {
      "tools": [
        "*"
      ],
      "type": "sse",
      "url": "http://127.0.0.1:8001/sse"
    },
    "Azure MCP Kusto Server": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start",
        "--mode",
        "single"
      ]
    },
    "todoist": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "sentry": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "feature-flags": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "/Users/gnfisher/.local/bin/feature-flags-mcp-server",
      "args": []
    }
  }
}
